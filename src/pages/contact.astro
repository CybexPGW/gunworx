---
import BaseLayout from '../layouts/BaseLayout.astro';
import { shop, shopMapsUrl } from '../data/business';
---

<BaseLayout
  title="Contact Us"
  description="Contact Cybex Precision Gunworx at 9540 Airport Hwy, Monclova, OH 43542. Hours are by appointment only. Call (419) 740-0456 or send a general inquiry."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "ContactPage",
        "name": "Contact Cybex Precision Gunworx",
        "url": "https://cybexprecisiongunworx.com/contact/",
        "mainEntity": { "@id": "https://cybexprecisiongunworx.com/#business" }
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://cybexprecisiongunworx.com/" },
          { "@type": "ListItem", "position": 2, "name": "Contact Us", "item": "https://cybexprecisiongunworx.com/contact/" }
        ]
      }
    ]
  })} />
  <div class="page-header">
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <span>Contact</span>
      </div>
      <h1>Contact Us</h1>
      <p>Send our team a general inquiry. We'll contact you using the details you provide.</p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="contact-grid">
        <!-- Contact Info -->
        <div style="display: flex; flex-direction: column; gap: var(--space-lg);">
          <div class="contact-info-card">
            <div class="contact-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <div>
              <h4 style="font-family: var(--font-heading); font-size: 1rem; color: var(--cpg-pure-white); text-transform: uppercase; margin-bottom: var(--space-xs);">Phone</h4>
              <a href="tel:+14197400456" style="color: var(--cpg-accent); font-weight: 600; font-size: 1.1rem;">(419) 740-0456</a>
            </div>
          </div>

          <div class="contact-info-card">
            <div class="contact-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </div>
            <div>
              <h4 style="font-family: var(--font-heading); font-size: 1rem; color: var(--cpg-pure-white); text-transform: uppercase; margin-bottom: var(--space-xs);">Email</h4>
              <a href="mailto:Info@CybexInc.com" style="color: var(--cpg-accent); font-weight: 600;">Info@CybexInc.com</a>
            </div>
          </div>

          <div class="contact-info-card">
            <div class="contact-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div>
              <h4 style="font-family: var(--font-heading); font-size: 1rem; color: var(--cpg-pure-white); text-transform: uppercase; margin-bottom: var(--space-xs);">Location</h4>
              <p style="color: var(--cpg-silver);">
                <a href={shopMapsUrl} target="_blank" rel="noopener" style="color: var(--cpg-silver);">{shop.street}<br />{shop.city}, {shop.region} {shop.postalCode}</a>
              </p>
            </div>
          </div>

          <div class="contact-info-card">
            <div class="contact-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15 14"/></svg>
            </div>
            <div>
              <h4 style="font-family: var(--font-heading); font-size: 1rem; color: var(--cpg-pure-white); text-transform: uppercase; margin-bottom: var(--space-xs);">Hours</h4>
              <p style="color: var(--cpg-silver);">{shop.hours}</p>
            </div>
          </div>

          <div class="contact-info-card">
            <div class="contact-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            </div>
            <div>
              <h4 style="font-family: var(--font-heading); font-size: 1rem; color: var(--cpg-pure-white); text-transform: uppercase; margin-bottom: var(--space-xs);">Social Media</h4>
              <a href="https://www.facebook.com/CybexPrecisionGunworx" target="_blank" rel="noopener" style="color: var(--cpg-accent); font-weight: 600;">Follow on Facebook →</a>
            </div>
          </div>
        </div>

        <!-- Contact Form -->
        <div>
          <h3 style="font-family: var(--font-heading); font-size: 1.3rem; color: var(--cpg-pure-white); text-transform: uppercase; margin-bottom: var(--space-lg);">Send Us a Message</h3>
          <p class="contact-form-intro">Enter your name, email, and message below. Phone is optional.</p>
          <div id="contact-fs-success" data-fs-success role="status" aria-live="polite" tabindex="-1"></div>
          <div id="contact-fs-error" data-fs-error role="alert" tabindex="-1"></div>

          <form class="contact-form" id="contact-form" action="https://formspree.io/f/maeerwpn" method="POST">
            <input type="hidden" name="_subject" value="General Inquiry - Cybex Precision Gunworx" />
            <input type="hidden" name="Recipient" value="Info@CybexInc.com" />
            <input type="hidden" name="Form" value="General Contact Inquiry" />
            <input type="text" name="_gotcha" style="display: none;" tabindex="-1" autocomplete="off" />

            <div class="form-row">
              <div class="form-group">
                <label for="name">Full Name</label>
                <input type="text" id="name" name="name" required maxlength="100" autocomplete="name" placeholder="Your full name" data-fs-field />
                <span data-fs-error="name"></span>
              </div>
              <div class="form-group">
                <label for="email">Your Email</label>
                <input type="email" id="email" name="email" required maxlength="254" autocomplete="email" placeholder="you@example.com" data-fs-field />
                <span data-fs-error="email"></span>
              </div>
            </div>

            <div class="form-group">
              <label for="phone">Phone (Optional)</label>
              <input type="tel" id="phone" name="phone" maxlength="40" autocomplete="tel" placeholder="Your phone number" data-fs-field />
              <span data-fs-error="phone"></span>
            </div>

            <div class="form-group">
              <label for="message">Message</label>
              <textarea id="message" name="message" required maxlength="5000" placeholder="How can we help?" data-fs-field></textarea>
              <span data-fs-error="message"></span>
            </div>

            <button type="submit" class="btn btn-primary" id="contact-submit" data-fs-submit-btn style="width: 100%; justify-content: center;">
              Submit Inquiry →
            </button>
            <p class="contact-form-note">We'll use these details to respond to your inquiry. <a href="/policies/privacy/">Privacy Policy</a></p>
            <noscript><p>Submitting will open our form service's confirmation page.</p></noscript>
          </form>
        </div>
      </div>
    </div>
  </section>

  <style>
    .contact-form-intro { margin-bottom: var(--space-lg); font-size: .9rem; }
    .contact-form-note { font-size: .8rem; }
    .contact-form-note a { text-decoration: underline; text-underline-offset: 3px; }
    #contact-submit:disabled { opacity: .65; cursor: wait; }
    [data-fs-success]:empty,
    [data-fs-error]:empty {
      display: none;
    }
    #contact-fs-success:not(:empty) {
      margin-bottom: var(--space-md);
      padding: 12px 16px;
      border-radius: var(--radius-md);
      font-size: 0.92rem;
      color: #3ddc84;
      background: rgba(61, 220, 132, 0.1);
      border: 1px solid rgba(61, 220, 132, 0.35);
    }
    #contact-fs-error:not(:empty) {
      margin-bottom: var(--space-md);
      padding: 12px 16px;
      border-radius: var(--radius-md);
      font-size: 0.92rem;
      color: #ff8a9a;
      background: rgba(200, 16, 46, 0.12);
      border: 1px solid rgba(200, 16, 46, 0.35);
    }
    .contact-form span[data-fs-error]:not(:empty) {
      display: block;
      margin-top: 4px;
      font-size: 0.8rem;
      color: #ff8a9a;
    }
    .contact-form [data-fs-field][aria-invalid="true"] {
      border-color: var(--cpg-accent);
    }
  </style>

  <script is:inline>
    (function () {
      const form = document.getElementById('contact-form');
      const successEl = document.getElementById('contact-fs-success');
      const errorEl = document.getElementById('contact-fs-error');
      const submitBtn = document.getElementById('contact-submit');
      if (!form || !successEl || !errorEl || !submitBtn) return;

      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        if (submitBtn.disabled) return;
        successEl.textContent = '';
        errorEl.textContent = '';
        const origLabel = submitBtn.textContent;
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending…';
        form.setAttribute('aria-busy', 'true');
        const controller = new AbortController();
        const timer = window.setTimeout(() => controller.abort(), 20000);
        try {
          const res = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { Accept: 'application/json' },
            signal: controller.signal,
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) {
            const msg = (data && data.errors && data.errors.map((err) => err.message).join(', ')) || 'Submission failed. Please try again.';
            throw new Error(msg);
          }
          form.reset();
          successEl.textContent = 'Thank you—we’ll contact you using the details you provided. You can also call us at (419) 740-0456.';
          successEl.focus();
        } catch (err) {
          errorEl.textContent = 'We could not confirm your submission. Your entries are still here. Please try again, email Info@CybexInc.com, or call (419) 740-0456.';
          errorEl.focus();
        } finally {
          window.clearTimeout(timer);
          submitBtn.disabled = false;
          submitBtn.textContent = origLabel;
          form.removeAttribute('aria-busy');
        }
      });
    })();
  </script>
</BaseLayout>

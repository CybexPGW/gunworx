---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="FFL Transfer"
  description="Cybex Precision Gunworx offers $25 FFL transfers in Toledo, Ohio. Fast processing, easy paperwork. Ship your online firearm purchase to our FFL."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Service",
        "name": "FFL Firearm Transfer Service",
        "description": "Flat-rate $25 FFL firearm transfer service in Toledo, Ohio including paperwork and NICS background check processing.",
        "provider": { "@id": "https://cybexprecisiongunworx.com/#business" },
        "areaServed": {
          "@type": "City",
          "name": "Toledo",
          "containedInPlace": { "@type": "State", "name": "Ohio" }
        },
        "offers": {
          "@type": "Offer",
          "price": "25.00",
          "priceCurrency": "USD",
          "availability": "https://schema.org/InStock",
          "url": "https://cybexprecisiongunworx.com/ffl-transfer/"
        }
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://cybexprecisiongunworx.com/" },
          { "@type": "ListItem", "position": 2, "name": "FFL Transfer", "item": "https://cybexprecisiongunworx.com/ffl-transfer/" }
        ]
      }
    ]
  })} />
  <div class="page-header">
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <span>FFL Transfer</span>
      </div>
      <h1>FFL Transfer Service</h1>
      <p>Fast, affordable FFL transfers. Ship your online purchase to us and walk out with your firearm.</p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="about-grid">
        <div>
          <span class="label" style="display:inline-block;font-size:0.75rem;font-weight:700;letter-spacing:0.2em;text-transform:uppercase;color:var(--cpg-accent);margin-bottom:var(--space-md);">Simple & Affordable</span>
          <h2 style="font-size: clamp(1.8rem, 4vw, 2.5rem); margin-bottom: var(--space-lg);">$25 FFL Transfers</h2>
          <p style="color: var(--cpg-silver); line-height: 1.8; margin-bottom: var(--space-md);">
            Bought a firearm online? We make the transfer process simple. Just have the seller ship directly to our FFL, and we'll handle the rest. Our flat-rate $25 transfer fee covers all the paperwork and background check processing.
          </p>

          <div style="margin: var(--space-xl) 0;">
            <h3 style="font-size: 1.1rem; margin-bottom: var(--space-lg);">How It Works</h3>
            <div style="display: flex; flex-direction: column; gap: var(--space-lg);">
              <div style="display: flex; align-items: flex-start; gap: var(--space-lg);">
                <div style="flex-shrink:0;width:40px;height:40px;background:var(--cpg-accent);border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:var(--font-heading);font-weight:700;font-size:1.1rem;color:white;">1</div>
                <div>
                  <h4 style="font-size: 0.95rem; margin-bottom: var(--space-xs);">Contact Us for FFL Info</h4>
                  <p style="color: var(--cpg-silver); font-size: 0.9rem;">Call or email us to get our FFL license information to provide to your online seller.</p>
                </div>
              </div>
              <div style="display: flex; align-items: flex-start; gap: var(--space-lg);">
                <div style="flex-shrink:0;width:40px;height:40px;background:var(--cpg-accent);border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:var(--font-heading);font-weight:700;font-size:1.1rem;color:white;">2</div>
                <div>
                  <h4 style="font-size: 0.95rem; margin-bottom: var(--space-xs);">Seller Ships to Us</h4>
                  <p style="color: var(--cpg-silver); font-size: 0.9rem;">Provide our FFL info to your seller and they ship the firearm directly to us.</p>
                </div>
              </div>
              <div style="display: flex; align-items: flex-start; gap: var(--space-lg);">
                <div style="flex-shrink:0;width:40px;height:40px;background:var(--cpg-accent);border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:var(--font-heading);font-weight:700;font-size:1.1rem;color:white;">3</div>
                <div>
                  <h4 style="font-size: 0.95rem; margin-bottom: var(--space-xs);">Pick Up Your Firearm</h4>
                  <p style="color: var(--cpg-silver); font-size: 0.9rem;">We notify you when it arrives. Come in, complete the 4473, pay the $25 fee, and take your firearm home.</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div>
          <div style="background: var(--cpg-charcoal); border: 1px solid var(--cpg-border); border-radius: var(--radius-lg); padding: var(--space-2xl);">
            <h3 style="font-size: 1.2rem; margin-bottom: var(--space-lg); text-align: center;">Transfer Details</h3>
            <table class="specs-table">
              <tbody>
                <tr><td>Transfer Fee</td><td style="color: var(--cpg-accent); font-weight: 700; font-size: 1.2rem;">$25.00</td></tr>
                <tr><td>Processing Time</td><td>Same day (when possible)</td></tr>
                <tr><td>Required ID</td><td>Valid government-issued photo ID</td></tr>
                <tr><td>Age Requirement</td><td>21+ for handguns, 18+ for long guns</td></tr>
                <tr><td>Background Check</td><td>NICS check required</td></tr>
                <tr><td>Payment</td><td>Cash, card accepted</td></tr>
              </tbody>
            </table>

            <div style="margin-top: var(--space-xl); padding: var(--space-md); background: rgba(200,16,46,0.08); border: 1px solid rgba(200,16,46,0.2); border-radius: var(--radius-md);">
              <p style="font-size: 0.85rem; color: var(--cpg-light); text-align: center;">
                <strong style="color: var(--cpg-accent);">Need our FFL info?</strong><br>
                Call <a href="tel:+14197400456" style="color: var(--cpg-accent); font-weight: 600;">(419) 740-0456</a> or email <a href="mailto:jmurphy@cybexinc.com" style="color: var(--cpg-accent);">jmurphy@cybexinc.com</a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

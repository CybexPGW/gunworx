---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 – Page Not Found" description="The page you're looking for doesn't exist.">
  <section class="section" style="padding-top: 200px; text-align: center; min-height: 70vh; display: flex; align-items: center;">
    <div class="container">
      <div style="font-family: var(--font-heading); font-size: clamp(5rem, 15vw, 10rem); font-weight: 900; color: var(--cpg-accent); line-height: 1; opacity: 0.3;">404</div>
      <h1 style="font-size: clamp(1.5rem, 3vw, 2.5rem); margin-bottom: var(--space-md);">Page Not Found</h1>
      <p style="color: var(--cpg-silver); margin-bottom: var(--space-xl); max-width: 400px; margin-left: auto; margin-right: auto;">
        The page you're looking for doesn't exist or has been moved. Let's get you back on target.
      </p>
      <div style="display: flex; gap: var(--space-md); justify-content: center; flex-wrap: wrap;">
        <a href="/" class="btn btn-primary">Go Home</a>
        <a href="/shop/" class="btn btn-outline">Browse Shop</a>
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RifleCard from '../../components/RifleCard.astro';
import NotifyMe from '../../components/NotifyMe.astro';
import { disciplines, riflesFor } from '../../data/disciplines';
import { rifles } from '../../data/readyToShip';

const site = 'https://cybexprecisiongunworx.com';
const path = '/guides/rimfire-vs-centerfire/';
const rimfireCount = rifles.filter((r) => r.platform === 'rimfire').length;
const centerfireCount = rifles.filter((r) => r.platform === 'centerfire').length;

const comparison = [
  { label: 'Ignition', rim: 'Priming compound inside the case’s hollow rim', center: 'Separate primer seated in the center of the case base' },
  { label: 'Ammunition', rim: 'Factory only; not designed to be reloaded', center: 'Factory or handloaded to suit the rifle' },
  { label: 'Typical match distance', rim: '25 – 300 yards', center: '100 yards to 1 mile+' },
  { label: 'Cost per round (match ammo)', rim: 'Cents to well under $1', center: 'About $1.50 – $3+ (factory match)' },
  { label: 'Recoil & noise', rim: 'Very low, easy all-day shooting', center: 'Moderate; brakes and suppressors help' },
  { label: 'Barrel life', rim: 'Tens of thousands of rounds', center: 'A few thousand rounds (depends on cartridge)' },
  { label: 'Range requirements', rim: 'Works at most local ranges', center: 'Needs longer ranges for full potential' },
  { label: 'Wind reading', rim: 'Very wind-sensitive, a great teacher', center: 'Critical at distance' },
  { label: 'Best for', rim: 'Learning, training volume, benchrest scoring', center: 'Distance, PRS/NRL, ELR, group benchrest' },
];

const faqs = [
  {
    q: 'What is the difference between rimfire and centerfire ammunition?',
    a: 'It comes down to how the cartridge is primed. Centerfire ammunition uses a separate primer seated in the center of the case base. Rimfire ammunition holds its priming compound inside the hollow rim of the case, and the firing pin strikes the rim to ignite it. Caliber alone does not determine which type a cartridge is.',
  },
  {
    q: 'Can you reload rimfire ammunition?',
    a: 'Conventional rimfire ammunition is not designed to be reloaded. That is why precision rimfire shooters test different brands, product lines, and manufacturing lots of factory ammunition to find what their rifle shoots best.',
  },
  {
    q: 'Should a beginner start with rimfire or centerfire?',
    a: 'Most new precision shooters progress fastest on rimfire. Low recoil, cheap ammunition, and close-range matches mean more trigger time and faster skill-building. Many top centerfire competitors still train on rimfire.',
  },
  {
    q: 'Is a .22LR really accurate enough for serious competition?',
    a: 'Yes. Rimfire benchrest and PRS Rimfire are serious disciplines with national-level competition. A precision-built .22 with a match barrel, a quality action, and a tuner can hold the tiny scoring rings used in ARA and IR 50/50 benchrest.',
  },
  {
    q: 'What does a tuner do on a rimfire rifle?',
    a: 'A tuner is an adjustable weight on the muzzle that changes barrel harmonics. Setting it for your ammunition lot can noticeably tighten groups and reduce vertical dispersion, which is why our benchrest rimfire rifles include one.',
  },
  {
    q: 'Is 6.5 Creedmoor good for ELR?',
    a: 'A heavy-barreled 6.5 Creedmoor is an excellent, manageable entry into long-range and 1,000-yard+ shooting. True ELR (well beyond a mile) usually moves to larger magnum cartridges. Call us and we can talk through your goals.',
  },
  {
    q: 'Do your rifles come ready to shoot?',
    a: 'Yes. Every rifle is professionally assembled, test-fired with match-grade ammunition, and cleaned. Rifles shipping with scopes are zeroed at 50 yards (rimfire) or 100 yards (centerfire). Each ships to your FFL dealer.',
  },
];

// Where a shooter is in the sport, and how we can help
const stages = [
  {
    n: '01',
    name: 'Beginner',
    text: 'New to the sport and want to try it before making a substantial investment.',
    fit: 'Start with our guides and talk to us. A rimfire rifle is often the most affordable way in.',
    cta: { label: 'Talk to Us', href: '/contact/' },
  },
  {
    n: '02',
    name: 'Developing Shooter',
    text: 'Some experience and ready to improve, but want guidance on what equipment to buy and why.',
    fit: 'Ready for the next step? Our complete packages take the guesswork out of component selection.',
    cta: { label: 'See Complete Packages', href: '/ready-to-ship/' },
    core: true,
  },
  {
    n: '03',
    name: 'Advancing Competitor',
    text: 'Having success in matches and recognize that better equipment could make you more competitive.',
    fit: 'This is who we build for: proven components, assembled and test-fired, in stock now.',
    cta: { label: 'Shop Ready to Ship', href: '/ready-to-ship/' },
    core: true,
  },
  {
    n: '04',
    name: 'Highly Experienced Competitor',
    text: 'Know exactly what you want. Many build their own or invest $10,000–$15,000 and wait a year or more for a particular gunsmith.',
    fit: 'Want that level of rifle without the wait? Ask what we have ready now.',
    cta: { label: 'Contact the Builder', href: '/contact/' },
  },
];
---

<BaseLayout
  title="Rimfire vs. Centerfire: Which Precision Rifle Is Right for You?"
  description="Rimfire vs. centerfire explained: how each cartridge is primed, why it matters for ammunition, how competitions differ, and which in-stock precision rifle fits your discipline and experience level."
  type="article"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Article',
        headline: 'Rimfire vs. Centerfire: Which Precision Rifle Is Right for You?',
        author: { '@type': 'Organization', name: 'Cybex Precision Gunworx' },
        publisher: { '@type': 'Organization', name: 'Cybex Precision Gunworx' },
        mainEntityOfPage: `${site}${path}`,
        image: `${site}/images/tool-room.webp`,
      },
      {
        '@type': 'FAQPage',
        mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
      },
    ],
  })} />

  <div class="page-header guide-header">
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <span>Guides</span>
        <span>/</span>
        <span>Rimfire vs. Centerfire</span>
      </div>
      <span class="guide-eyebrow">Shooter’s Guide</span>
      <h1>Rimfire vs. Centerfire</h1>
      <p>Which precision rifle fits your discipline? A straight-talk guide to PRS Rimfire, benchrest, PRS, and long range, with in-stock picks for each.</p>
      <nav class="guide-topics" aria-label="On this page">
        <a href="#priming">How They’re Primed</a>
        <a href="#ammunition">Ammunition</a>
        <a href="#competition">Competition</a>
        <a href="#your-level">Your Experience Level</a>
      </nav>
      <nav class="guide-jump" aria-label="Jump to discipline">
        {disciplines.map((d) => (
          <a href={`#${d.id}`} class={`guide-jump-${d.platform}`}>{d.name}</a>
        ))}
      </nav>
    </div>
  </div>

  <!-- The core difference: priming -->
  <section class="section section-darker" id="priming">
    <div class="container" style="max-width: 1080px;">
      <div class="section-header">
        <span class="label">The Core Difference</span>
        <h2>It’s All in How the Cartridge Is Primed</h2>
        <p>The main difference between centerfire and rimfire is the priming system: the part that ignites the powder.</p>
      </div>
      <div class="prime-grid">
        <article class="prime-card prime-card-centerfire">
          <svg class="prime-svg" viewBox="0 0 160 160" role="img" aria-labelledby="cf-svg-title">
            <title id="cf-svg-title">Base of a centerfire cartridge with the primer in the center</title>
            <circle cx="80" cy="80" r="66" fill="#b8893b" />
            <circle cx="80" cy="80" r="58" fill="#d4a24e" />
            <circle cx="80" cy="80" r="52" fill="none" stroke="#a87a30" stroke-width="2" />
            <circle cx="80" cy="80" r="17" fill="#c9ccd1" stroke="#f0b429" stroke-width="4" class="prime-pulse" />
            <circle cx="80" cy="80" r="4" fill="#55585e" />
          </svg>
          <span class="guide-tag guide-tag-centerfire">Centerfire</span>
          <h3>Primer in the Center</h3>
          <p>A centerfire cartridge has four main components:</p>
          <ul>
            <li><strong>Case</strong>, usually made of brass</li>
            <li><strong>Primer</strong>, seated in the center of the case’s base</li>
            <li><strong>Powder</strong></li>
            <li><strong>Bullet</strong>, the projectile that leaves the barrel</li>
          </ul>
          <p class="prime-foot">The primer’s position gives centerfire ammunition its name. Every component must be appropriate for the particular cartridge and firearm.</p>
        </article>
        <article class="prime-card prime-card-rimfire">
          <svg class="prime-svg" viewBox="0 0 160 160" role="img" aria-labelledby="rf-svg-title">
            <title id="rf-svg-title">Base of a rimfire cartridge with priming compound in the rim and a firing pin strike at the edge</title>
            <circle cx="80" cy="80" r="66" fill="none" stroke="#c8102e" stroke-width="10" class="prime-pulse" />
            <circle cx="80" cy="80" r="58" fill="#d4a24e" />
            <circle cx="80" cy="80" r="40" fill="none" stroke="#a87a30" stroke-width="2" />
            <rect x="72" y="10" width="16" height="9" rx="2" fill="#55585e" />
          </svg>
          <span class="guide-tag guide-tag-rimfire">Rimfire</span>
          <h3>Priming in the Rim</h3>
          <p>Rimfire ammunition contains a case, priming compound, powder, and a bullet, but no separate primer.</p>
          <ul>
            <li>The <strong>priming compound</strong> is contained inside the case’s hollow rim</li>
            <li>The <strong>firing pin strikes the rim</strong> to ignite the cartridge</li>
            <li>Modern rimfire ammunition is generally <strong>small caliber</strong></li>
            <li><strong>.22 Long Rifle</strong> is a common choice for precision rimfire benchrest</li>
          </ul>
          <p class="prime-foot">Caliber alone does not determine whether ammunition is rimfire or centerfire. The priming system does.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Quick answer -->
  <section class="section">
    <div class="container">
      <div class="guide-split">
        <article class="guide-choice guide-choice-rimfire">
          <span class="guide-choice-tag">Rimfire · .22LR</span>
          <h2>Choose rimfire if you…</h2>
          <ul>
            <li>Are new to precision shooting and want to build skills fast</li>
            <li>Want high-volume practice without high ammo costs</li>
            <li>Shoot at local ranges of 25 – 300 yards</li>
            <li>Want to compete in PRS Rimfire, NRL22, or rimfire benchrest</li>
          </ul>
          <a href="/ready-to-ship/?type=rimfire" class="btn btn-outline guide-choice-btn">See {rimfireCount} Rimfire Rifles →</a>
        </article>
        <div class="guide-vs" aria-hidden="true">VS</div>
        <article class="guide-choice guide-choice-centerfire">
          <span class="guide-choice-tag">Centerfire · 6.5 CM · .223 · 6 PPC</span>
          <h2>Choose centerfire if you…</h2>
          <ul>
            <li>Want to shoot steel at 600, 1,000 yards, and beyond</li>
            <li>Compete (or plan to) in centerfire PRS / NRL or ELR</li>
            <li>Chase one-hole groups in centerfire benchrest</li>
            <li>Have access to longer ranges</li>
          </ul>
          <a href="/ready-to-ship/?type=centerfire" class="btn btn-outline guide-choice-btn">See {centerfireCount} Centerfire Rifles →</a>
        </article>
      </div>
    </div>
  </section>

  <!-- Comparison table -->
  <section class="section section-dark">
    <div class="container" style="max-width: 980px;">
      <div class="section-header">
        <span class="label">Side by Side</span>
        <h2>How They Compare</h2>
      </div>
      <div class="guide-table-wrap">
        <table class="guide-table">
          <thead>
            <tr><th scope="col"></th><th scope="col" class="th-rim">Rimfire</th><th scope="col" class="th-center">Centerfire</th></tr>
          </thead>
          <tbody>
            {comparison.map((row) => (
              <tr><th scope="row">{row.label}</th><td>{row.rim}</td><td>{row.center}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="guide-note">Costs and distances are typical ranges and vary by ammunition, match format, and venue.</p>
    </div>
  </section>

  <!-- Why it matters: ammunition -->
  <section class="section" id="ammunition">
    <div class="container" style="max-width: 1080px;">
      <div class="section-header">
        <span class="label">Why It Matters</span>
        <h2>Ammunition: Tailor It or Test It</h2>
        <p>Both centerfire and rimfire rifles can be sensitive to ammunition. The difference is how much control the shooter has over it.</p>
      </div>
      <div class="ammo-grid">
        <article class="ammo-card ammo-card-centerfire">
          <span class="ammo-verb">Tailor</span>
          <h3>Centerfire shooters can handload</h3>
          <p>Many centerfire competitors handload their ammunition, giving them control over component selection and consistency.</p>
          <p>Developing ammunition that performs well in a particular rifle takes experience, careful testing, and detailed records.</p>
        </article>
        <article class="ammo-card ammo-card-rimfire">
          <span class="ammo-verb">Test</span>
          <h3>Rimfire shooters select factory ammo</h3>
          <p>Conventional rimfire ammunition is not designed to be reloaded, so competitors depend on factory ammunition.</p>
          <p>They test different brands, product lines, and manufacturing lots to find what performs best in their particular rifle. <a href="/blog/22lr-ammo-lot-testing/">How .22LR lot testing works →</a></p>
        </article>
      </div>
      <blockquote class="ammo-callout">
        <p><strong>Even two rifles from the same manufacturer can perform differently with the same ammunition.</strong> Barrel characteristics, vibration, ammunition consistency, and other factors all affect results. Finding the right rifle-and-ammunition combination is a major part of precision rimfire shooting. That’s why our rimfire rifles are built with <a href="/blog/how-rimfire-tuners-work/">tuners</a>.</p>
      </blockquote>
    </div>
  </section>

  <!-- How the competitions differ -->
  <section class="section section-dark" id="competition">
    <div class="container" style="max-width: 1080px;">
      <div class="section-header">
        <span class="label">On the Line</span>
        <h2>How the Competitions Differ</h2>
      </div>
      <div class="comp-grid">
        <article class="comp-card comp-card-centerfire">
          <span class="guide-tag guide-tag-centerfire">Centerfire</span>
          <div class="comp-stat">300 – 1,000+ <small>yards</small></div>
          <h3>Many disciplines, many distances</h3>
          <p>Centerfire competition includes several disciplines. Some emphasize hits on targets at varying distances, while others measure group size or score on paper. Depending on the discipline, distances range from a few hundred yards to well beyond 1,000 yards.</p>
        </article>
        <article class="comp-card comp-card-rimfire">
          <span class="guide-tag guide-tag-rimfire">Rimfire Benchrest</span>
          <div class="comp-stat">&lt; 1/16″ <small>can decide a match</small></div>
          <h3>Exceptionally small margins, commonly at 50 yards</h3>
          <p>Precision rimfire benchrest demands exceptionally small margins of error. Fractions of a sixteenth of an inch can separate a winning score from the rest of the field.</p>
          <div class="ara-box">
            <h4>Example: American Rimfire Association (ARA) scoring</h4>
            <ul>
              <li><strong>25 scoring bulls</strong> per target</li>
              <li>Shots score by placement; a shot that completely removes the center dot also earns an <strong>“X”</strong></li>
              <li><strong>Worst-edge scoring:</strong> a shot that breaks a scoring line receives the lower value</li>
              <li>Results reflect performance across multiple targets, with tie-breaks set by the applicable rules</li>
            </ul>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Disciplines -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="label">By Discipline</span>
        <h2>Find Your Discipline</h2>
        <p>What each discipline demands from a rifle, and which in-stock Cybex rifles are built for it.</p>
      </div>

      {disciplines.map((d, i) => {
        const picks = riflesFor(d);
        return (
          <article class={`guide-disc guide-disc-${d.platform}`} id={d.id}>
            <header class="guide-disc-head">
              <span class="guide-disc-num">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <div class="guide-disc-tags">
                  <span class={`guide-tag guide-tag-${d.platform}`}>{d.platform}</span>
                  <span class="guide-tag">{d.distances}</span>
                </div>
                <h3>{d.name}</h3>
                <p class="guide-disc-tagline">{d.tagline}</p>
              </div>
            </header>
            <div class="guide-disc-body">
              <div>
                <p class="guide-disc-about">{d.about}</p>
                <p class="guide-disc-best"><strong>Best for:</strong> {d.bestFor}</p>
              </div>
              <div class="guide-matters">
                <h4>What matters in the rifle</h4>
                <ul>{d.whatMatters.map((w) => <li>{w}</li>)}</ul>
              </div>
            </div>
            {picks.length > 0 ? (
              <div class="guide-picks">
                <div class="guide-picks-head">
                  <h4>In stock for {d.name} <span>({picks.length})</span></h4>
                </div>
                <div class="guide-picks-grid">
                  {picks.slice(0, 3).map((r) => <RifleCard rifle={r} />)}
                </div>
                {picks.length > 3 && (
                  <a href="/ready-to-ship/" class="btn-add-cart guide-more">+ {picks.length - 3} more in Ready to Ship →</a>
                )}
              </div>
            ) : (
              <p class="guide-none">Nothing in stock for this discipline right now. Join the alert list below and we’ll let you know.</p>
            )}
          </article>
        );
      })}
    </div>
  </section>

  <!-- Shooter stages + builder note -->
  <section class="section section-darker" id="your-level">
    <div class="container">
      <div class="section-header">
        <span class="label">Your Experience Level</span>
        <h2>Where Are You in the Sport?</h2>
        <p>Both disciplines require specialized equipment. Here’s how our complete rifle packages fit each stage.</p>
      </div>
      <div class="stage-grid">
        {stages.map((s) => (
          <article class={`stage-card${s.core ? ' stage-card-core' : ''}`}>
            {s.core && <span class="stage-badge">Built for You</span>}
            <span class="stage-num">{s.n}</span>
            <h3>{s.name}</h3>
            <p class="stage-text">{s.text}</p>
            <p class="stage-fit">{s.fit}</p>
            <a href={s.cta.href} class={`btn ${s.core ? 'btn-primary' : 'btn-outline'} stage-btn`}>{s.cta.label} →</a>
          </article>
        ))}
      </div>

      <div class="builder-note">
        <span class="label">From the Builder</span>
        <h3>Why We Build Complete Rifle Packages</h3>
        <p>I started in centerfire shooting, and most of my rifle-building experience comes from that world. Today I’m expanding into precision rimfire benchrest shooting and competition.</p>
        <p>Both disciplines demand specialized equipment, and many shooters don’t have the time, experience, or resources to assemble a competitive custom rifle themselves, especially as they move into more demanding competition. So I decided to put that experience to work in complete rifle packages: proven components, assembled, test-fired, and ready to compete.</p>
        <div class="builder-actions">
          <a href="/ready-to-ship/?type=rimfire" class="btn btn-outline">Rimfire Rifles ({rimfireCount})</a>
          <a href="/ready-to-ship/?type=centerfire" class="btn btn-outline">Centerfire Rifles ({centerfireCount})</a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section-dark">
    <div class="container" style="max-width: 860px;">
      <div class="section-header">
        <span class="label">FAQ</span>
        <h2>Common Questions</h2>
      </div>
      <div class="guide-faq">
        {faqs.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Notify + help -->
  <section class="section">
    <div class="container">
      <NotifyMe
        source="Guide – Rimfire vs Centerfire"
        heading="Know Your Discipline? Get Alerted First."
        text="Pick what you shoot and we’ll email you when a matching rifle is ready to ship. Still deciding? Call (419) 740-0456 and talk it through with us."
      />
    </div>
  </section>
</BaseLayout>

<style>
  .prime-grid, .ammo-grid, .comp-grid { display: grid; grid-template-columns: 1fr; gap: var(--space-lg); }
  @media (min-width: 860px) { .prime-grid, .ammo-grid, .comp-grid { grid-template-columns: 1fr 1fr; } }
  .prime-card, .ammo-card, .comp-card {
    position: relative; padding: var(--space-2xl); border-radius: var(--radius-lg);
    background: var(--cpg-charcoal); border: 1px solid var(--cpg-border);
  }
  .prime-card-centerfire, .ammo-card-centerfire, .comp-card-centerfire { border-top: 3px solid #f0b429; }
  .prime-card-rimfire, .ammo-card-rimfire, .comp-card-rimfire { border-top: 3px solid var(--cpg-accent); }
  .prime-svg { width: 120px; height: 120px; display: block; margin: 0 auto var(--space-lg); filter: drop-shadow(0 10px 20px rgba(0,0,0,0.5)); }
  .prime-pulse { animation: primePulse 2.4s ease-in-out infinite; }
  @keyframes primePulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.55; } }
  @media (prefers-reduced-motion: reduce) { .prime-pulse { animation: none; } }
  .prime-card h3, .ammo-card h3, .comp-card h3 { font-size: 1.35rem; margin: var(--space-sm) 0 var(--space-md); }
  .prime-card p, .ammo-card p, .comp-card p { color: var(--cpg-light); line-height: 1.75; }
  .prime-card ul { display: grid; gap: 8px; margin: var(--space-md) 0; }
  .prime-card li { position: relative; padding-left: 22px; color: var(--cpg-light); }
  .prime-card li::before { content: ''; position: absolute; left: 0; top: 11px; width: 10px; height: 2px; }
  .prime-card-centerfire li::before { background: #f0b429; }
  .prime-card-rimfire li::before { background: var(--cpg-accent); }
  .prime-card strong, .ammo-card strong, .comp-card strong { color: var(--cpg-pure-white); }
  .prime-foot { font-size: 0.9rem; color: var(--cpg-silver) !important; border-top: 1px solid var(--cpg-border); padding-top: var(--space-md); }

  .ammo-verb {
    display: block; font-family: var(--font-heading); font-size: 3.2rem; line-height: 1; font-weight: 700;
    text-transform: uppercase; color: transparent;
  }
  .ammo-card-centerfire .ammo-verb { -webkit-text-stroke: 1px rgba(240,180,41,0.7); }
  .ammo-card-rimfire .ammo-verb { -webkit-text-stroke: 1px rgba(200,16,46,0.8); }
  .ammo-card p + p { margin-top: var(--space-sm); }
  .ammo-card a, .ammo-callout a { color: #ff4d6a; text-decoration: underline; text-underline-offset: 3px; }
  .ammo-callout {
    margin: var(--space-xl) 0 0; padding: var(--space-lg) var(--space-xl);
    border-left: 4px solid var(--cpg-accent); background: rgba(200,16,46,0.08);
    border-radius: 0 var(--radius-md) var(--radius-md) 0; color: var(--cpg-light); line-height: 1.75;
  }
  .ammo-callout strong { color: var(--cpg-pure-white); }

  .comp-stat { font-family: var(--font-heading); font-size: 2.2rem; font-weight: 700; color: var(--cpg-pure-white); margin-top: var(--space-md); }
  .comp-stat small { font-size: 0.85rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--cpg-silver); font-weight: 500; }
  .ara-box { margin-top: var(--space-lg); padding: var(--space-lg); background: var(--cpg-dark); border: 1px solid var(--cpg-border); border-radius: var(--radius-md); }
  .ara-box h4 { font-size: 0.8rem; letter-spacing: 0.12em; color: var(--cpg-silver); margin-bottom: var(--space-md); }
  .ara-box ul { display: grid; gap: 8px; }
  .ara-box li { position: relative; padding-left: 20px; font-size: 0.92rem; color: var(--cpg-light); }

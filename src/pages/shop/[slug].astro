---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products, categories } from '../../data/products';

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const categoryName = categories.find(c => c.slug === product.category)?.name || product.category;
const relatedProducts = products.filter(p => p.category === product.category && p.id !== product.id).slice(0, 3);
---

<BaseLayout
  title={product.name}
  description={product.description}
  type="product"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": product.name,
    "description": product.description,
    "sku": product.sku,
    "image": `https://cybexprecisiongunworx.com${product.image}`,
    "brand": {
      "@type": "Brand",
      "name": "Cybex Precision Gunworx"
    },
    "offers": {
      "@type": "Offer",
      "price": product.price,
      "priceCurrency": "USD",
      "availability": product.inStock ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
      "seller": {
        "@type": "Organization",
        "name": "Cybex Precision Gunworx"
      }
    }
  })} />

  <section class="section product-detail">
    <div class="container">
      <div class="breadcrumb" style="justify-content: flex-start; margin-bottom: var(--space-xl);">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/shop/">Shop</a>
        <span>/</span>
        <a href={`/shop/?category=${product.category}`}>{categoryName}</a>
        <span>/</span>
        <span style="color: var(--cpg-light);">{product.name}</span>
      </div>

      <div class="product-detail-grid">
        <div class="product-detail-image">
          <div class="product-placeholder" style="width:100%;height:100%;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width:80px;height:80px;"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
          </div>
        </div>

        <div class="product-detail-info">
          <span class="product-category" style="margin-bottom: var(--space-sm);">{categoryName}</span>
          <h1>{product.name}</h1>
          <div class="product-detail-price">${product.price.toFixed(2)}</div>

          <p class="product-detail-desc">{product.description}</p>

          {product.specs && (
            <div>
              <h3 style="font-size: 1rem; margin-bottom: var(--space-md); color: var(--cpg-silver);">Specifications</h3>
              <table class="specs-table">
                <tbody>
                  {Object.entries(product.specs).map(([key, value]) => (
                    <tr>
                      <td>{key}</td>
                      <td>{value}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          <div style="display: flex; gap: var(--space-md); flex-wrap: wrap;">
            {product.inStock ? (
              <button
                class="snipcart-add-item btn btn-primary"
                data-item-id={product.id}
                data-item-price={product.price}
                data-item-url={`/shop/${product.slug}/`}
                data-item-description={product.description.substring(0, 150)}
                data-item-name={product.name}
                data-item-image={product.image}
                style="flex: 1; justify-content: center;"
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                Add to Cart
              </button>
            ) : (
              <button class="btn btn-outline" disabled style="flex: 1; justify-content: center; opacity: 0.5; cursor: not-allowed;">
                Out of Stock
              </button>
            )}
          </div>

          {(product.category === 'complete-firearms' || product.category === 'ar-15-lowers') && (
            <div style="margin-top: var(--space-lg); padding: var(--space-md); background: rgba(200,16,46,0.08); border: 1px solid rgba(200,16,46,0.2); border-radius: var(--radius-md);">
              <p style="font-size: 0.85rem; color: var(--cpg-light);">
                <strong style="color: var(--cpg-accent);">⚠ FFL Required:</strong> This item must be shipped to a licensed Federal Firearms Licensee (FFL) dealer. <a href="/ffl-transfer/" style="color: var(--cpg-accent); text-decoration: underline;">Learn about our FFL transfer service →</a>
              </p>
            </div>
          )}
        </div>
      </div>

      {relatedProducts.length > 0 && (
        <div style="margin-top: var(--space-4xl);">
          <h2 style="font-size: 1.5rem; margin-bottom: var(--space-xl);">Related Products</h2>
          <div class="product-grid">
            {relatedProducts.map((rp) => (
              <article class="product-card">
                <a href={`/shop/${rp.slug}/`} class="product-card-image">
                  <div class="product-placeholder">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                  </div>
                </a>
                <div class="product-card-body">
                  <span class="product-category">{categories.find(c => c.slug === rp.category)?.name}</span>
                  <h3 class="product-name"><a href={`/shop/${rp.slug}/`}>{rp.name}</a></h3>
                  <div class="product-footer">
                    <div class="product-price">${rp.price.toFixed(2)}</div>
                    <a href={`/shop/${rp.slug}/`} class="btn-add-cart">View →</a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

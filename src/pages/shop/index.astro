---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products, categories } from '../../data/products';
import { rifles } from '../../data/readyToShip';
import RifleCard from '../../components/RifleCard.astro';
import ComplianceNotice from '../../components/ComplianceNotice.astro';
---

<BaseLayout
  title="Shop"
  description="Browse PQP benchrest rifle rests, interchangeable front tops, boreguides, action wrenches, bolt tools, and ready-to-ship precision rifles from Cybex Precision Gunworx."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "ItemList",
        "name": "Benchrest Rests, Front Tops & Precision Tools",
        "itemListElement": products.map((p, idx) => ({
          "@type": "ListItem",
          "position": idx + 1,
          "url": `https://cybexprecisiongunworx.com/shop/${p.slug}/`,
          "name": p.name
        }))
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://cybexprecisiongunworx.com/" },
          { "@type": "ListItem", "position": 2, "name": "Shop", "item": "https://cybexprecisiongunworx.com/shop/" }
        ]
      }
    ]
  })} />
  <div class="page-header">
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <span>Shop</span>
      </div>
      <h1>Shop All Products</h1>
      <p>Competition benchrest rests, front tops, precision maintenance tools, and ready-to-ship rifles.</p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <ComplianceNotice />
      <div style="height: var(--space-xl);"></div>

      <!-- Ready to Ship Rifles -->
      <div style="margin-bottom: var(--space-4xl);">
        <div class="section-header">
          <span class="label">In Stock · Ships Now</span>
          <h2>Ready to Ship Rifles</h2>
          <p>Competition-ready rimfire and centerfire rifles, assembled, test-fired, and zeroed.</p>
        </div>
        <div class="rts-shop-grid">
          {rifles.slice(0, 4).map((r) => <RifleCard rifle={r} />)}
        </div>
        <div style="text-align: center; margin-top: var(--space-2xl);">
          <a href="/ready-to-ship/" class="btn btn-primary">View All {rifles.length} Ready to Ship Rifles →</a>
        </div>
      </div>

      <div class="section-header">
        <span class="label">Benchrest &amp; Range Gear</span>
        <h2>Rests, Front Tops &amp; Precision Tools</h2>
        <p>PQP mechanical rests, 1-piece rests, interchangeable front tops, boreguides, and maintenance tools.</p>
      </div>

      <!-- Category Filter -->
      <div class="category-filter" id="category-filter">
        {categories.map((cat) => (
          <button
            type="button"
            class={`category-btn ${cat.slug === 'all' ? 'active' : ''}`}
            data-category={cat.slug}
          >
            {cat.name}
          </button>
        ))}
        <a href="/ready-to-ship/" class="category-btn" style="text-decoration: none;">
          Ready to Ship Rifles ({rifles.length}) →
        </a>
      </div>

      <!-- Product Grid -->
      <div class="product-grid" id="product-grid">
        {products.map((product) => (
          <article
            class="product-card"
            data-category={product.category}
            itemscope
            itemtype="https://schema.org/Product"
          >
            <a href={`/shop/${product.slug}/`} class="product-card-image" style="background: #fff;">
              <img
                src={product.image}
                alt={product.name}
                loading="lazy"
                style="object-fit: contain; padding: 12px;"
              />
              {product.featured && <span class="product-badge">Featured</span>}
              {!product.inStock && <span class="product-badge" style="background: var(--cpg-steel);">Sold Out</span>}
            </a>
            <div class="product-card-body">
              <span class="product-category">
                {categories.find(c => c.slug === product.category)?.name}
              </span>
              <h3 class="product-name" itemprop="name">
                <a href={`/shop/${product.slug}/`}>{product.name}</a>
              </h3>
              <p class="product-desc" itemprop="description">{product.description}</p>
              <div class="product-footer">
                <div class="product-price" itemprop="offers" itemscope itemtype="https://schema.org/Offer">
                  <span itemprop="price" content={product.price.toString()}>
                    ${product.price.toFixed(2)}
                  </span>
                  <meta itemprop="priceCurrency" content="USD" />
                  <meta itemprop="availability" content={product.inStock ? "https://schema.org/InStock" : "https://schema.org/OutOfStock"} />
                </div>
                {product.inStock && (
                  <button
                    type="button"
                    class="btn-add-cart"
                    data-wc-add
                    data-wc-id={product.wooId}
                    data-wc-image={product.image}
                    data-wc-url={`/shop/${product.slug}/`}
                  >
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    Add
                  </button>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- FFL Reminder -->
      <div class="ffl-banner">
        <div class="ffl-banner-icon">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#c8102e" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <div>
          <h3>Firearms Require FFL Transfer</h3>
          <p>All complete firearms and serialized lower receivers must be shipped to a licensed FFL dealer. We offer <strong>$25 FFL transfers</strong> at our location, or we can ship to your local FFL. <a href="/ffl-transfer/" style="color: var(--cpg-accent); text-decoration: underline;">Learn more →</a></p>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    // Category Filter
    const filterBtns = document.querySelectorAll('.category-btn[data-category]');
    const cards = document.querySelectorAll('.product-card[data-category]');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const cat = btn.dataset.category;
        cards.forEach(card => {
          if (cat === 'all' || card.dataset.category === cat) {
            card.style.display = '';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // Handle URL params (?category=... and ?q=...)
    const params = new URLSearchParams(window.location.search);
    const urlCat = params.get('category');
    if (urlCat) {
      const targetBtn = document.querySelector(`.category-btn[data-category="${urlCat}"]`);
      if (targetBtn) targetBtn.click();
    }
    const urlQuery = (params.get('q') || '').trim().toLowerCase();
    if (urlQuery) {
      cards.forEach(card => {
        const text = (card.textContent || '').toLowerCase();
        card.style.display = text.includes(urlQuery) ? '' : 'none';
      });
    }
  </script>

  <style>
    .rts-shop-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 500px), 1fr));
      gap: var(--space-xl);
    }
  </style>
</BaseLayout>

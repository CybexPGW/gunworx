---
import BaseLayout from '../layouts/BaseLayout.astro';
import { noShipStates } from '../data/compliance';

const usStates = [
  { code: 'AL', name: 'Alabama' }, { code: 'AK', name: 'Alaska' }, { code: 'AZ', name: 'Arizona' },
  { code: 'AR', name: 'Arkansas' }, { code: 'CA', name: 'California' }, { code: 'CO', name: 'Colorado' },
  { code: 'CT', name: 'Connecticut' }, { code: 'DE', name: 'Delaware' }, { code: 'FL', name: 'Florida' },
  { code: 'GA', name: 'Georgia' }, { code: 'HI', name: 'Hawaii' }, { code: 'ID', name: 'Idaho' },
  { code: 'IL', name: 'Illinois' }, { code: 'IN', name: 'Indiana' }, { code: 'IA', name: 'Iowa' },
  { code: 'KS', name: 'Kansas' }, { code: 'KY', name: 'Kentucky' }, { code: 'LA', name: 'Louisiana' },
  { code: 'ME', name: 'Maine' }, { code: 'MD', name: 'Maryland' }, { code: 'MA', name: 'Massachusetts' },
  { code: 'MI', name: 'Michigan' }, { code: 'MN', name: 'Minnesota' }, { code: 'MS', name: 'Mississippi' },
  { code: 'MO', name: 'Missouri' }, { code: 'MT', name: 'Montana' }, { code: 'NE', name: 'Nebraska' },
  { code: 'NV', name: 'Nevada' }, { code: 'NH', name: 'New Hampshire' }, { code: 'NJ', name: 'New Jersey' },
  { code: 'NM', name: 'New Mexico' }, { code: 'NY', name: 'New York' }, { code: 'NC', name: 'North Carolina' },
  { code: 'ND', name: 'North Dakota' }, { code: 'OH', name: 'Ohio' }, { code: 'OK', name: 'Oklahoma' },
  { code: 'OR', name: 'Oregon' }, { code: 'PA', name: 'Pennsylvania' }, { code: 'RI', name: 'Rhode Island' },
  { code: 'SC', name: 'South Carolina' }, { code: 'SD', name: 'South Dakota' }, { code: 'TN', name: 'Tennessee' },
  { code: 'TX', name: 'Texas' }, { code: 'UT', name: 'Utah' }, { code: 'VT', name: 'Vermont' },
  { code: 'VA', name: 'Virginia' }, { code: 'WA', name: 'Washington' }, { code: 'WV', name: 'West Virginia' },
  { code: 'WI', name: 'Wisconsin' }, { code: 'WY', name: 'Wyoming' },
];

const restrictedCodes = noShipStates.map((s) => s.code);
---

<BaseLayout
  title="Checkout"
  description="Secure checkout for Cybex Precision Gunworx firearms, benchrest rests, and accessories."
  noindex={true}
>
  <div class="page-header">
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/shop/">Shop</a>
        <span>/</span>
        <span>Checkout</span>
      </div>
      <h1>Secure Checkout</h1>
      <p>Encrypted payment processing powered by WooCommerce &amp; Accept.blue.</p>
    </div>
  </div>

  <section class="section">
    <div class="container" id="co-root" data-restricted={JSON.stringify(restrictedCodes)}>
      <!-- Empty Cart State -->
      <div class="co-empty" id="co-empty" hidden>
        <h2>Your Cart Is Empty</h2>
        <p>Add a Ready to Ship rifle or benchrest accessory before checking out.</p>
        <div class="co-empty-actions">
          <a href="/ready-to-ship/" class="btn btn-primary">Browse Ready to Ship Rifles →</a>
          <a href="/shop/" class="btn btn-outline">Browse Accessories</a>
        </div>
      </div>

      <!-- Order Confirmation State -->
      <div class="co-success" id="co-success" hidden>
        <div class="co-success-icon">
          <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="#3ddc84" stroke-width="2.5">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
        </div>
        <span class="co-success-tag">Order Confirmed</span>
        <h2>Thank You for Your Order</h2>
        <p class="co-success-order">
          Order <strong id="co-order-number">#—</strong> has been received and is being processed.
        </p>
        <div class="co-success-ffl">
          <h3>Next Steps for Firearm Orders (FFL Transfer)</h3>
          <p>
            If your order includes a firearm, please have your receiving FFL dealer email a signed copy of their license to
            <a href="mailto:Info@CybexInc.com">Info@CybexInc.com</a> referencing your order number, or call us at
            <a href="tel:+14197400456">(419) 740-0456</a>.
          </p>
        </div>
        <div class="co-empty-actions">
          <a href="/" class="btn btn-primary">Return Home →</a>
          <a href="/ready-to-ship/" class="btn btn-outline">Browse More Rifles</a>
        </div>
      </div>

      <!-- Main Checkout Grid -->
      <form class="co-grid" id="co-form" novalidate>
        <div class="co-main">
          <div class="co-alert" id="co-error" hidden></div>

          <!-- 1. Contact & Billing -->
          <div class="co-card">
            <div class="co-card-head">
              <span class="co-step">1</span>
              <h2>Contact &amp; Billing Information</h2>
            </div>

            <div class="co-fields">
              <div class="co-row-2">
                <div class="co-field">
                  <label for="billing_first_name">First Name *</label>
                  <input type="text" id="billing_first_name" name="billing_first_name" autocomplete="given-name" required />
                </div>
                <div class="co-field">
                  <label for="billing_last_name">Last Name *</label>
                  <input type="text" id="billing_last_name" name="billing_last_name" autocomplete="family-name" required />
                </div>
              </div>

              <div class="co-row-2">
                <div class="co-field">
                  <label for="billing_email">Email Address *</label>
                  <input type="email" id="billing_email" name="billing_email" autocomplete="email" required />
                </div>
                <div class="co-field">
                  <label for="billing_phone">Phone Number *</label>
                  <input type="tel" id="billing_phone" name="billing_phone" autocomplete="tel" required />
                </div>
              </div>

              <div class="co-field">
                <label for="billing_address_1">Billing Street Address *</label>
                <input type="text" id="billing_address_1" name="billing_address_1" autocomplete="address-line1" required />
              </div>

              <div class="co-field">
                <label for="billing_address_2">Apartment, Suite, Unit (Optional)</label>
                <input type="text" id="billing_address_2" name="billing_address_2" autocomplete="address-line2" />
              </div>

              <div class="co-row-3">
                <div class="co-field">
                  <label for="billing_city">City *</label>
                  <input type="text" id="billing_city" name="billing_city" autocomplete="address-level2" required />
                </div>
                <div class="co-field">
                  <label for="billing_state">State *</label>
                  <select id="billing_state" name="billing_state" autocomplete="address-level1" required>
                    <option value="">Select State…</option>
                    {usStates.map((s) => (
                      <option value={s.code} selected={s.code === 'OH'}>{s.name}</option>
                    ))}
                  </select>
                </div>
                <div class="co-field">
                  <label for="billing_postcode">ZIP Code *</label>
                  <input type="text" id="billing_postcode" name="billing_postcode" autocomplete="postal-code" required />
                </div>
              </div>
            </div>
          </div>

          <!-- 2. FFL Dealer / Shipping Destination -->
          <div class="co-card">
            <div class="co-card-head">
              <span class="co-step">2</span>
              <h2>Shipping &amp; FFL Transfer Details</h2>
            </div>

            <div class="co-ffl-box" id="co-ffl-box">
              <div class="co-ffl-banner">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#c8102e" stroke-width="2">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
                <div>
                  <strong>Federal Firearms License (FFL) Notice:</strong>
                  All complete firearms and serialized receivers ship only to a licensed FFL dealer. Non-serialized accessories ship directly to your address.
                </div>
              </div>

              <label class="co-checkbox">
                <input type="checkbox" id="ffl_local_pickup" />
                <span>Transfer at <strong>Cybex Precision Gunworx (Toledo, OH)</strong> — $25 FFL transfer fee</span>
              </label>

              <div class="co-row-2" id="ffl_dealer_fields">
                <div class="co-field">
                  <label for="ffl_dealer_name">Receiving FFL Dealer Name (If ordering a firearm)</label>
                  <input type="text" id="ffl_dealer_name" placeholder="e.g., Buckeye Tactical FFL" />
                </div>
                <div class="co-field">
                  <label for="ffl_dealer_contact">FFL Phone / Email / License # (Optional if sending later)</label>
                  <input type="text" id="ffl_dealer_contact" placeholder="Dealer phone or email" />
                </div>
              </div>
            </div>

            <label class="co-checkbox" style="margin-top: var(--space-md);">
              <input type="checkbox" id="ship_same_as_billing" checked />
              <span>Shipping address is the same as billing address</span>
            </label>

            <div class="co-fields" id="shipping_fields_wrap" hidden style="margin-top: var(--space-lg);">
              <div class="co-row-2">
                <div class="co-field">
                  <label for="shipping_first_name">Recipient First Name *</label>
                  <input type="text" id="shipping_first_name" />
                </div>
                <div class="co-field">
                  <label for="shipping_last_name">Recipient Last Name *</label>
                  <input type="text" id="shipping_last_name" />
                </div>
              </div>
              <div class="co-field">
                <label for="shipping_company">FFL Business / Company Name (Optional)</label>
                <input type="text" id="shipping_company" />
              </div>
              <div class="co-field">
                <label for="shipping_address_1">Shipping Street Address *</label>
                <input type="text" id="shipping_address_1" />
              </div>
              <div class="co-field">
                <label for="shipping_address_2">Suite / Unit (Optional)</label>
                <input type="text" id="shipping_address_2" />
              </div>
              <div class="co-row-3">
                <div class="co-field">
                  <label for="shipping_city">City *</label>
                  <input type="text" id="shipping_city" />
                </div>
                <div class="co-field">
                  <label for="shipping_state">State *</label>
                  <select id="shipping_state">
                    <option value="">Select State…</option>
                    {usStates.map((s) => (
                      <option value={s.code} selected={s.code === 'OH'}>{s.name}</option>
                    ))}
                  </select>
                </div>
                <div class="co-field">
                  <label for="shipping_postcode">ZIP Code *</label>
                  <input type="text" id="shipping_postcode" />
                </div>
              </div>
            </div>

            <div class="co-field" style="margin-top: var(--space-lg);">
              <label for="customer_note">Order Notes (Optional)</label>
              <textarea id="customer_note" rows="2" placeholder="Special instructions, preferred FFL details, or questions…"></textarea>
            </div>
          </div>

          <!-- 3. Payment (Accept.blue) -->
          <div class="co-card">
            <div class="co-card-head">
              <span class="co-step">3</span>
              <h2>Payment Details</h2>
            </div>

            <p class="co-pay-sub">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#3ddc84" stroke-width="2">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
              256-bit SSL encrypted credit card processing via Accept.blue.
            </p>

            <div class="co-fields">
              <div class="co-field">
                <label for="cc_number">Card Number *</label>
                <input
                  type="text"
                  id="cc_number"
                  placeholder="•••• •••• •••• ••••"
                  autocomplete="cc-number"
                  inputmode="numeric"
                  maxlength="19"
                  required
                />
              </div>

              <div class="co-row-2">
                <div class="co-field">
                  <label for="cc_expiry">Expiration Date (MM/YY) *</label>
                  <input
                    type="text"
                    id="cc_expiry"
                    placeholder="MM/YY"
                    autocomplete="cc-exp"
                    inputmode="numeric"
                    maxlength="5"
                    required
                  />
                </div>
                <div class="co-field">
                  <label for="cc_cvv">Security Code (CVV) *</label>
                  <input
                    type="password"
                    id="cc_cvv"
                    placeholder="•••"
                    autocomplete="cc-csc"
                    inputmode="numeric"
                    maxlength="4"
                    required
                  />
                </div>
              </div>
            </div>

            <button type="submit" class="btn btn-primary co-submit-btn" id="co-submit-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
              <span id="co-submit-text">Place Order</span>
            </button>
          </div>
        </div>

        <!-- Order Summary Sidebar -->
        <aside class="co-sidebar">
          <div class="co-card co-summary-card">
            <h2>Order Summary</h2>
            <ul class="co-items" id="co-items"></ul>

            <!-- Coupon Code -->
            <div class="co-coupon">
              <input type="text" id="co-coupon-input" placeholder="Promo / coupon code" />
              <button type="button" class="btn btn-outline co-coupon-btn" id="co-coupon-btn">Apply</button>
            </div>
            <div class="co-coupons-applied" id="co-coupons-applied"></div>

            <div class="co-totals">
              <div class="co-total-row">
                <span>Subtotal</span>
                <span id="co-subtotal">$0.00</span>
              </div>
              <div class="co-total-row" id="co-pkg-row" hidden>
                <span>Selected Rifle Package Upgrade</span>
                <span id="co-pkg-delta">$0.00</span>
              </div>
              <div class="co-total-row" id="co-discount-row" hidden>
                <span>Discount</span>
                <span id="co-discount">-$0.00</span>
              </div>
              <div class="co-total-row">
                <span>Tax</span>
                <span id="co-tax">$0.00</span>
              </div>
              <div class="co-total-row co-grand-total">
                <span>Total</span>
                <strong id="co-total">$0.00</strong>
              </div>
            </div>
          </div>
        </aside>
      </form>
    </div>
  </section>
</BaseLayout>

<script is:inline>
(function () {
  const rootEl = document.getElementById('co-root');
  const formEl = document.getElementById('co-form');
  const emptyEl = document.getElementById('co-empty');
  const successEl = document.getElementById('co-success');
  const errorEl = document.getElementById('co-error');
  const itemsEl = document.getElementById('co-items');
  const subtotalEl = document.getElementById('co-subtotal');
  const pkgRowEl = document.getElementById('co-pkg-row');
  const pkgDeltaEl = document.getElementById('co-pkg-delta');
  const discountRowEl = document.getElementById('co-discount-row');
  const discountEl = document.getElementById('co-discount');
  const taxEl = document.getElementById('co-tax');
  const totalEl = document.getElementById('co-total');
  const submitBtn = document.getElementById('co-submit-btn');
  const submitText = document.getElementById('co-submit-text');

  const shipSameCheck = document.getElementById('ship_same_as_billing');
  const shipWrap = document.getElementById('shipping_fields_wrap');
  const fflPickupCheck = document.getElementById('ffl_local_pickup');
  const fflDealerFields = document.getElementById('ffl_dealer_fields');

  const ccNumber = document.getElementById('cc_number');
  const ccExpiry = document.getElementById('cc_expiry');
  const ccCvv = document.getElementById('cc_cvv');

  const restrictedStates = JSON.parse((rootEl && rootEl.dataset.restricted) || '[]');

  function formatDollars(n) {
    return Number(n || 0).toLocaleString('en-US', { style: 'currency', currency: 'USD' });
  }

  function setError(msg) {
    if (!errorEl) return;
    if (!msg) {
      errorEl.hidden = true;
      errorEl.textContent = '';
    } else {
      errorEl.textContent = msg;
      errorEl.hidden = false;
      errorEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  }

  // Format card inputs
  if (ccNumber) {
    ccNumber.addEventListener('input', () => {
      const digits = ccNumber.value.replace(/\D/g, '').slice(0, 16);
      ccNumber.value = digits.replace(/(\d{4})(?=\d)/g, '$1 ').trim();
    });
  }
  if (ccExpiry) {
    ccExpiry.addEventListener('input', () => {
      const digits = ccExpiry.value.replace(/\D/g, '').slice(0, 4);
      ccExpiry.value = digits.length >= 3 ? `${digits.slice(0, 2)}/${digits.slice(2, 4)}` : digits;
    });
  }
  if (ccCvv) {
    ccCvv.addEventListener('input', () => {
      ccCvv.value = ccCvv.value.replace(/\D/g, '').slice(0, 4);
    });
  }

  if (shipSameCheck && shipWrap) {
    shipSameCheck.addEventListener('change', () => {
      shipWrap.hidden = shipSameCheck.checked;
    });
  }
  if (fflPickupCheck && fflDealerFields) {
    fflPickupCheck.addEventListener('change', () => {
      fflDealerFields.style.opacity = fflPickupCheck.checked ? '0.5' : '1';
    });
  }

  function decodeHtml(str) {
    const txt = document.createElement('textarea');
    txt.innerHTML = str || '';
    return txt.value;
  }

  function getAddressesFromForm() {
    const val = (id) => (document.getElementById(id)?.value || '').trim();
    const billing = {
      first_name: val('billing_first_name'),
      last_name: val('billing_last_name'),
      company: '',
      address_1: val('billing_address_1'),
      address_2: val('billing_address_2'),
      city: val('billing_city'),
      state: val('billing_state') || 'OH',
      postcode: val('billing_postcode'),
      country: 'US',
      email: val('billing_email'),
      phone: val('billing_phone'),
    };
    const same = !shipSameCheck || shipSameCheck.checked;
    const shipping = same
      ? {
          first_name: billing.first_name,
          last_name: billing.last_name,
          company: val('ffl_dealer_name'),
          address_1: billing.address_1,
          address_2: billing.address_2,
          city: billing.city,
          state: billing.state,
          postcode: billing.postcode,
          country: 'US',
          phone: billing.phone,
        }
      : {
          first_name: val('shipping_first_name') || billing.first_name,
          last_name: val('shipping_last_name') || billing.last_name,
          company: val('shipping_company') || val('ffl_dealer_name'),
          address_1: val('shipping_address_1'),
          address_2: val('shipping_address_2'),
          city: val('shipping_city'),
          state: val('shipping_state') || billing.state,
          postcode: val('shipping_postcode'),
          country: 'US',
          phone: billing.phone,
        };
    return { billing_address: billing, shipping_address: shipping };
  }

  function renderCheckoutCart(cart) {
    if (!window.CPGCart) return;
    const items = (cart && Array.isArray(cart.items)) ? cart.items : [];
    if (items.length === 0) {
      if ( (successEl && !successEl.hidden) ) return;
      if (formEl) formEl.hidden = true;
      if (emptyEl) emptyEl.hidden = false;
      return;
    }

    if (emptyEl) emptyEl.hidden = true;
    if (formEl && (!successEl || successEl.hidden)) formEl.hidden = false;

    const metaMap = window.CPGCart.getItemMeta();
    const { wcSubtotal, packageDelta, minorUnit } = window.CPGCart.computeCartDisplayTotals(cart);

    const discount = Number(cart?.totals?.total_discount || 0) / Math.pow(10, minorUnit);
    const tax = Number(cart?.totals?.total_tax || 0) / Math.pow(10, minorUnit);
    const wcTotal = Number(cart?.totals?.total_price || 0) / Math.pow(10, minorUnit);
    const grandTotal = wcTotal + packageDelta;

    if (subtotalEl) subtotalEl.textContent = formatDollars(wcSubtotal);
    if (pkgRowEl && pkgDeltaEl) {
      pkgRowEl.hidden = packageDelta <= 0;
      pkgDeltaEl.textContent = `+${formatDollars(packageDelta)}`;
    }
    if (discountRowEl && discountEl) {
      discountRowEl.hidden = discount <= 0;
      discountEl.textContent = `-${formatDollars(discount)}`;
    }
    if (taxEl) taxEl.textContent = formatDollars(tax);
    if (totalEl) totalEl.textContent = formatDollars(grandTotal);
    if (submitText) submitText.textContent = `Place Order · ${formatDollars(grandTotal)}`;

    if (itemsEl) {
      itemsEl.innerHTML = items.map((item) => {
        const m = metaMap[String(item.id)] || {};
        const imgSrc = m.localImage || (item.images && item.images[0] && item.images[0].thumbnail) || '/images/cybex-logo.webp';
        const name = decodeHtml(item.name);
        const baseUnit = Number(item.prices?.price || 0) / Math.pow(10, minorUnit);
        const unitPrice = (m.packagePrice && Number(m.packagePrice) > baseUnit) ? Number(m.packagePrice) : baseUnit;
        const pkgHtml = m.packageLabel ? `<div class="co-item-pkg">${decodeHtml(m.packageLabel)}</div>` : '';
        return `
          <li class="co-item">
            <img src="${imgSrc}" alt="${name.replace(/"/g, '&quot;')}" width="56" height="56" />
            <div class="co-item-body">
              <div class="co-item-title">${name}</div>
              ${pkgHtml}
              <div class="co-item-meta">Qty: ${item.quantity}</div>
            </div>
            <div class="co-item-price">${formatDollars(unitPrice * item.quantity)}</div>
          </li>
        `;
      }).join('');
    }

    // Coupons
    const couponsWrap = document.getElementById('co-coupons-applied');
    if (couponsWrap) {
      const coupons = (cart && cart.coupons) || [];
      couponsWrap.innerHTML = coupons.map((c) => `
        <span class="co-coupon-tag">
          ${c.code}
          <button type="button" data-remove-coupon="${c.code}" aria-label="Remove coupon ${c.code}">×</button>
        </span>
      `).join('');
    }
  }

  // Subscribe to cart updates once CPGCart is ready
  function initCheckout() {
    if (!window.CPGCart) {
      setTimeout(initCheckout, 50);
      return;
    }
    window.CPGCart.subscribe(renderCheckoutCart);
    window.CPGCart.refreshCart();

    // Update customer state/zip on change to recalculate tax
    ['billing_state', 'billing_postcode', 'shipping_state', 'shipping_postcode'].forEach((id) => {
      const el = document.getElementById(id);
      if (el) {
        el.addEventListener('change', () => {
          const { billing_address, shipping_address } = getAddressesFromForm();
          window.CPGCart.updateCustomer({
            billing_address: {
              state: billing_address.state || 'OH',
              postcode: billing_address.postcode || '',
              country: 'US',
            },
            shipping_address: {
              state: shipping_address.state || 'OH',
              postcode: shipping_address.postcode || '',
              country: 'US',
            },
          }).catch(() => {});
        });
      }
    });

    // Coupon apply / remove
    const couponBtn = document.getElementById('co-coupon-btn');
    const couponInput = document.getElementById('co-coupon-input');
    if (couponBtn && couponInput) {
      couponBtn.addEventListener('click', async () => {
        const code = couponInput.value.trim();
        if (!code) return;
        couponBtn.disabled = true;
        setError('');
        try {
          await window.CPGCart.applyCoupon(code);
          couponInput.value = '';
        } catch (err) {
          setError(err.message || 'Invalid coupon code.');
        } finally {
          couponBtn.disabled = false;
        }
      });
    }
    const couponsApplied = document.getElementById('co-coupons-applied');
    if (couponsApplied) {
      couponsApplied.addEventListener('click', async (e) => {
        const btn = e.target.closest('button[data-remove-coupon]');
        if (!btn) return;
        try {
          await window.CPGCart.removeCoupon(btn.dataset.removeCoupon);
        } catch (_) {}
      });
    }

    // Form submission
    if (formEl) {
      formEl.addEventListener('submit', async (e) => {
        e.preventDefault();
        setError('');

        const { billing_address, shipping_address } = getAddressesFromForm();
        if (!billing_address.first_name || !billing_address.last_name || !billing_address.email || !billing_address.phone || !billing_address.address_1 || !billing_address.city || !billing_address.state || !billing_address.postcode) {
          setError('Please complete all required contact and billing address fields.');
          return;
        }

        const cart = window.CPGCart.getCart();
        const { hasFirearm } = window.CPGCart.computeCartDisplayTotals(cart);
        const destState = shipping_address.state || billing_address.state;
        if (hasFirearm && restrictedStates.includes(destState)) {
          setError(`We cannot ship firearms to ${destState}. Please review our Restricted States policy.`);
          return;
        }

        const num = (ccNumber?.value || '').trim();
        const exp = (ccExpiry?.value || '').trim();
        const cvv = (ccCvv?.value || '').trim();
        if (!num || !exp || !cvv) {
          setError('Please enter your credit card number, expiration date, and security code.');
          return;
        }

        // Build customer note with FFL details & any selected rifle package options
        const notes = [];
        const userNote = (document.getElementById('customer_note')?.value || '').trim();
        if (userNote) notes.push(userNote);

        if (fflPickupCheck && fflPickupCheck.checked) {
          notes.push('FFL Transfer: Local Transfer at Cybex Precision Gunworx (Toledo, OH - $25 fee)');
        } else {
          const fflName = (document.getElementById('ffl_dealer_name')?.value || '').trim();
          const fflContact = (document.getElementById('ffl_dealer_contact')?.value || '').trim();
          if (fflName || fflContact) {
            notes.push(`Receiving FFL Dealer: ${[fflName, fflContact].filter(Boolean).join(' | ')}`);
          }
        }

        const metaMap = window.CPGCart.getItemMeta();
        (cart?.items || []).forEach((item) => {
          const m = metaMap[String(item.id)];
          if (m && m.packageLabel) {
            notes.push(`${decodeHtml(item.name)} Package: ${m.packageLabel} ($${Number(m.packagePrice || 0).toLocaleString()})`);
          }
        });

        submitBtn.disabled = true;
        const prevText = submitText.textContent;
        submitText.textContent = 'Processing Order…';

        try {
          // 1. Tokenize card via Accept.blue
          const avsAddress = [billing_address.address_1, billing_address.address_2].filter(Boolean).join(' ').trim().slice(0, 255);
          const avsZip = billing_address.postcode.slice(0, 50);
          const tokenData = await window.CPGCart.tokenizeCard({
            number: num,
            expiry: exp,
            cvv: cvv,
            avs_address: avsAddress,
            avs_zip: avsZip,
          });

          // 2. Submit WooCommerce Store API checkout
          const orderResult = await window.CPGCart.submitCheckout({
            billing_address,
            shipping_address,
            customer_note: notes.join('\n'),
            payment_method: 'acceptbluev2',
            payment_data: [
              { key: 'token', value: String(tokenData.token || '') },
              { key: 'acceptbluev2-expiry-month', value: String(tokenData.expiry_month || '') },
              { key: 'acceptbluev2-expiry-year', value: String(tokenData.expiry_year || '') },
              { key: 'acceptbluev2-last4', value: String(tokenData.last4 || '') },
              { key: 'acceptbluev2-save-card', value: '0' },
            ],
          });

          if (orderResult && orderResult.payment_result && orderResult.payment_result.payment_status === 'failure') {
            const failMsg = (orderResult.payment_result.payment_details || []).find((d) => d.key === 'errorMessage')?.value;
            throw new Error(failMsg || 'Payment was declined. Please verify your card information.');
          }

          // Show confirmation screen
          const orderNumEl = document.getElementById('co-order-number');
          if (orderNumEl) {
            orderNumEl.textContent = `#${orderResult.order_number || orderResult.order_id || ''}`;
          }
          formEl.hidden = true;
          if (emptyEl) emptyEl.hidden = true;
          if (successEl) {
            successEl.hidden = false;
            successEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        } catch (err) {
          setError(err.message || 'Unable to process your order. Please verify your details or call (419) 740-0456.');
        } finally {
          submitBtn.disabled = false;
          submitText.textContent = prevText;
        }
      });
    }
  }

  initCheckout();
})();
</script>


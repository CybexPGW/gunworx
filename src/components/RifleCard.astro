---
import { type Rifle, rifleUrl, formatPrice, fromPrice, keyComponents } from '../data/readyToShip';

interface Props { rifle: Rifle; eager?: boolean }
const { rifle, eager = false } = Astro.props;
const url = rifleUrl(rifle);
const hasPackages = rifle.packages.length > 0;
const mediaBg = rifle.imageBgs?.[0] ?? '#ffffff';
---

<article class="rifle-card" data-platform={rifle.platform}>
  <a href={url} class="rifle-card-media" style={`background: ${mediaBg};`} aria-label={`View ${rifle.name}`}>
    <img
      src={rifle.images[0]}
      alt={`${rifle.name} – ${rifle.caliber} precision rifle`}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      width="1600"
      height="900"
    />
    <span class="rifle-badge"><span class="rifle-badge-dot"></span>In Stock · Ships Now</span>
    {rifle.code && <span class="rifle-code">{rifle.code}</span>}
  </a>
  <div class="rifle-card-body">
    <div class="rifle-meta">
      <span class={`rifle-platform rifle-platform-${rifle.platform}`}>{rifle.platform}</span>
      {rifle.caliber && <span class="rifle-caliber">{rifle.caliber.replace(/ Bolt Action/i, '')}</span>}
    </div>
    <h3 class="rifle-name"><a href={url}>{rifle.name}</a></h3>
    <p class="rifle-components">{keyComponents(rifle)}</p>
    <div class="rifle-footer">
      <div class="rifle-price">
        {hasPackages && <span class="rifle-price-from">From</span>}
        {formatPrice(fromPrice(rifle))}
      </div>
      <a href={url} class="btn-add-cart">View Rifle →</a>
    </div>
  </div>
</article>

<style>
  .rifle-card {
    display: flex;
    flex-direction: column;
    background: var(--cpg-charcoal);
    border: 1px solid var(--cpg-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform var(--transition-base), border-color var(--transition-base), box-shadow var(--transition-base);
  }
  .rifle-card:hover {
    transform: translateY(-4px);
    border-color: rgba(200, 16, 46, 0.45);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
  }
  .rifle-card-media {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 8.5;
    min-height: 230px;
    padding: 12px 16px;
    overflow: hidden;
    background: #ffffff;
  }
  .rifle-card-media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.5s ease;
  }
  .rifle-card:hover .rifle-card-media img { transform: scale(1.03); }
  .rifle-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    background: rgba(10, 10, 10, 0.78);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 999px;
  }
  .rifle-badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #3ddc84;
    box-shadow: 0 0 0 0 rgba(61, 220, 132, 0.6);
    animation: rts-pulse 2s infinite;
  }
  @keyframes rts-pulse {
    0% { box-shadow: 0 0 0 0 rgba(61, 220, 132, 0.6); }
    70% { box-shadow: 0 0 0 7px rgba(61, 220, 132, 0); }
    100% { box-shadow: 0 0 0 0 rgba(61, 220, 132, 0); }
  }
  .rifle-code {
    position: absolute;
    bottom: 12px;
    right: 12px;
    padding: 3px 8px;
    font-family: var(--font-heading);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--cpg-light);
    background: rgba(10, 10, 10, 0.7);
    border-radius: 4px;
  }
  .rifle-card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-lg);
    gap: var(--space-sm);
  }
  .rifle-meta { display: flex; gap: var(--space-sm); flex-wrap: wrap; }
  .rifle-platform,
  .rifle-caliber {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 4px;
  }
  .rifle-platform { color: var(--cpg-accent); background: rgba(200, 16, 46, 0.12); }
  .rifle-platform-centerfire { color: #f0b429; background: rgba(240, 180, 41, 0.12); }
  .rifle-caliber { color: var(--cpg-silver); background: rgba(255, 255, 255, 0.06); }
  .rifle-name {
    font-size: 1.15rem;
    line-height: 1.2;
    margin: var(--space-xs) 0 0;
  }
  .rifle-name a:hover { color: var(--cpg-accent); }
  .rifle-components { color: var(--cpg-silver); font-size: 0.85rem; flex: 1; }
  .rifle-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding-top: var(--space-md);
    border-top: 1px solid var(--cpg-border);
  }
  .rifle-price {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--cpg-pure-white);
    line-height: 1;
  }
  .rifle-price-from {
    display: block;
    font-family: var(--font-body, inherit);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cpg-silver);
    margin-bottom: 4px;
  }
</style>
